# Copy this to terraform.tfvars (it's gitignored). The defaults in variables.tf
# are the names from my own proof of concept. Swap yourname for your short name
# in the resource group and the mail nickname, and set the owner tag to your name.
# Don't put the password or the alert address here. Those stay in .env.

resource_group_name = "rg-gov-poc-yourname01"
user_mail_nickname  = "junior-dev-yourname"

tags = {
  project     = "azure-governance-poc"
  environment = "poc"
  managed-by  = "terraform"
  owner       = "yourname"
}
